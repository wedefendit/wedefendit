{
  "name": "defendit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3005 --turbopack",
    "build": "next build --webpack",
    "start": "next start --port 3005",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "lucide-react": "0.511.0",
    "next": "16.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.1.7",
    "@types/leaflet": "1.9.21",
    "@types/node": "20.19.39",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "oxlint": "1.83.0",
    "tailwindcss": "4.1.7",
    "typescript": "5.8.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "postcss": "8.5.23"
  },
  "allowScripts": {
    "@tailwindcss/oxide@4.1.7": true,
    "unrs-resolver@1.7.2": true
  },
  "dis": {
    "gates": {
      "oxlint": ["npm", "run", "lint"],
      "typescript": ["npm", "exec", "--", "tsc", "--noEmit"],
      "unit": ["npm", "test"],
      "production-build": ["npm", "run", "build"],
      "production-browser": ["npm", "run", "test:e2e"]
    }
  }
}
